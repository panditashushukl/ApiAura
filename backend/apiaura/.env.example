# Project Configurations
APPLICATION_NAME=ApiAura

# CORS Variable
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database configurations
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=my_app_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password

# JWT Configurations
JWT_SECRET=your-strong-secret-key-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# Development Configurations
API_EXECUTION_ALLOW_LOCAL_DEVELOPMENT=false
SCRIPT_MAX_EXECUTION_TIME_MS=1000

# Gemini AI Configurations
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Default Admin Configurations
ADMIN_EMAIL=admin@apiaura.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Admin
ADMIN_ROLE_CODE=ADMIN
ADMIN_ROLE_NAME=Administrator